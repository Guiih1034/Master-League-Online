# Porta HTTP do servidor local
PORT=3000
# Caminho do arquivo SQLite. No Vercel, se vazio, usa /tmp/liga.db (efêmero).
DB_PATH=
# Base de jogadores usada no seed automático
PLAYERS_FILE=./FC26_20250921.csv
SEED_GAME=fc26
NODE_ENV=development
# 1 para cookie secure em HTTPS, 0 para desenvolvimento local
HTTPS=0

# Verificação de e-mail (SMTP). Sem SMTP, o link aparece no log/resposta dev.
APP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
