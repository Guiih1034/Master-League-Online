{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install",
  "outputDirectory": "public",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30,
      "includeFiles": "{server/**,data/**,FC26_20250921.csv,players-fc26.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path]"
    }
  ]
}